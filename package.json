{
  "name": "le-veilleur",
  "private": true,
  "description": "Quotidien d'analyse rédigé chaque matin par une rédaction d'agents Claude",
  "type": "module",
  "scripts": {
    "build": "node bin/construire.mjs",
    "test": "node --test test/*.test.mjs",
    "verifier": "node bin/verifier.mjs content/*/*.md",
    "edition": "bin/edition.sh",
    "journal": "node bin/journal.mjs",
    "serve": "node bin/construire.mjs && python3 -m http.server 8000 --directory _site"
  },
  "engines": {
    "node": ">=20"
  }
}
